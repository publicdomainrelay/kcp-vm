{
  "name": "hono-plc",
  "description": "did:plc directory server",
  "options": {
    "port": {
      "type": "number",
      "description": "Port to listen on",
      "env": "PORT",
      "default": 2587
    },
    "hostname": {
      "type": "string",
      "description": "Hostname to bind to",
      "env": "HOSTNAME",
      "default": "127.0.0.1"
    },
    "tls-cert-file": {
      "type": "string",
      "description": "PEM certificate to serve TLS with; requires tls-key-file",
      "env": "TLS_CERT_FILE"
    },
    "tls-key-file": {
      "type": "string",
      "description": "PEM private key to serve TLS with; requires tls-cert-file",
      "env": "TLS_KEY_FILE"
    }
  }
}
