[Unit]
Description=socialweb-computer bidder for %i (run bidder)
StartLimitIntervalSec=0

[Service]
Type=exec
Slice=socialweb.slice
WorkingDirectory={{.State}}
Environment=CONFIG_PATH_SOCIALWEB_COMPUTER={{.State}}/config.json
ExecStart={{.State}}/bin/current/socialweb-computer run bidder --handle %i
Restart=always
RestartSec=5
KillMode=control-group

[Install]
WantedBy=default.target
