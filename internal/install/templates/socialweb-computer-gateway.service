[Unit]
Description=socialweb-computer gateway (serve gateway kcp)
StartLimitIntervalSec=0

[Service]
Type=exec
Slice=socialweb.slice
WorkingDirectory={{.State}}
Environment=CONFIG_PATH_SOCIALWEB_COMPUTER={{.State}}/config.json
EnvironmentFile=-{{.State}}/gateway.env
ExecStart={{.State}}/bin/current/socialweb-computer serve gateway kcp
Restart=always
RestartSec=5
KillMode=control-group
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10000

[Install]
WantedBy=default.target
