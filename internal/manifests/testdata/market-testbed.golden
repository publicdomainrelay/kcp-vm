--- # 50-verifier.yaml
apiVersion: deno.computer/v1alpha1
kind: DenoPod
metadata:
  name: verifier
  namespace: default
  finalizers:
    - denopod.deno.computer/run
spec:
  restartPolicy: Never
  serviceAccount:
    name: deno-runner
    namespace: default
  env:
    VERIFY_PDS: "https://pds.default.alice.svc.kcp.local"
    VERIFY_PLC: "https://plc.default.global.svc.kcp.local"
    VERIFY_RELAY: "wss://relay.default.relay.svc.kcp.local/xrpc/com.atproto.sync.subscribeRepos"
  script: |
    // This pod does its own TLS and its own name resolution, so unlike the
    // service pods there is no child process to hand a --preload to: the shim
    // is imported here, and importing it runs its top-level patches.
    const shim = Deno.env.get("KCP_SHIM") ?? "";
    if (shim) await import(`file://${shim}`);

    const PDS = Deno.env.get("VERIFY_PDS")!;
    const PLC = Deno.env.get("VERIFY_PLC")!;
    const RELAY = Deno.env.get("VERIFY_RELAY")!;

    const out: Record<string, string> = {};
    const handle = `alice-${Date.now().toString(36)}`;
    const password = "hunter2-hunter2";

    function record(body: unknown): Promise<Response> {
      return fetch(`${PDS}/xrpc/com.atproto.repo.createRecord`, {
        method: "POST",
        headers: { "content-type": "application/json", authorization: `Bearer ${out.accessJwt}` },
        body: JSON.stringify(body),
      });
    }

    function post(text: string) {
      return { repo: out.did, collection: "app.bsky.feed.post", record: { $type: "app.bsky.feed.post", text, createdAt: new Date().toISOString() } };
    }

    // Watches the relay for a commit that names our repository. The relay only
    // carries a PDS after that PDS has announced itself, which it does on its
    // first write, so this is started after a first record and a pause.
    //
    // Frames arrive as bytes: the relay emits DRISL, and a CBOR string is its
    // bytes verbatim, so decoding and searching finds the DID. Searching only
    // string frames is why this first reported a timeout with the commit
    // actually flowing.
    let frames = 0;
    function watchRelay(): Promise<string> {
      return new Promise<string>((resolve) => {
        let settled = false;
        const done = (v: string) => {
          if (settled) return;
          settled = true;
          try { ws.close(); } catch { /* already closing */ }
          resolve(v);
        };
        const ws = new WebSocket(RELAY);
        const timer = setTimeout(() => done("timeout"), 90_000);
        ws.onmessage = async (ev) => {
          frames++;
          let text = "";
          if (typeof ev.data === "string") text = ev.data;
          else if (ev.data instanceof ArrayBuffer) text = new TextDecoder().decode(new Uint8Array(ev.data));
          else if (ev.data instanceof Blob) text = new TextDecoder().decode(new Uint8Array(await ev.data.arrayBuffer()));
          if (out.did && text.includes(out.did)) {
            clearTimeout(timer);
            done("yes");
          }
        };
        ws.onerror = () => {
          clearTimeout(timer);
          done("error");
        };
        ws.onclose = () => {
          clearTimeout(timer);
          done("closed");
        };
      });
    }

    try {
      const created = await fetch(`${PDS}/xrpc/com.atproto.server.createAccount`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ handle, password }),
      });
      out.createAccountStatus = String(created.status);
      const body = await created.json();
      out.did = String(body.did ?? "");
      out.handle = String(body.handle ?? "");
      out.accessJwt = String(body.accessJwt ?? "");
      out.gotAccessJwt = out.accessJwt ? "yes" : "no";

      // Registration in the PLC directory happens inside createAccount when the
      // PDS is configured with a directory URL, so this reads back what it wrote.
      if (out.did) {
        const plc = await fetch(`${PLC}/${out.did}`);
        out.plcStatus = String(plc.status);
        if (plc.ok) {
          const doc = await plc.json();
          out.plcAlsoKnownAs = JSON.stringify(doc.alsoKnownAs ?? []);
          out.plcService = JSON.stringify(doc.service ?? []);
        }
      }

      // The first write is what makes the PDS announce itself to the relay.
      const first = await record(post("first write, which announces this PDS to the relay"));
      out.firstWriteStatus = String(first.status);

      const watching = watchRelay();
      await new Promise((r) => setTimeout(r, 10_000));
      const second = await record(post("second write, which the relay should carry"));
      out.secondWriteStatus = String(second.status);
      out.relaySawCommit = await watching;
      out.relayFrames = String(frames);
    } catch (err) {
      out.error = err instanceof Error ? err.message : String(err);
    }

    out.verdict = out.plcStatus === "200" && out.relaySawCommit === "yes" && out.gotAccessJwt === "yes"
      ? "pass"
      : "fail";
    await Deno.writeTextFile("result.json", JSON.stringify(out));
    Deno.exit(out.verdict === "pass" ? 0 : 1);
  permissions:
    read:
      allow: true
    write:
      allowList:
        - result.json
    net:
      allow: true
    env:
      allowList:
        - KCP_SHIM
        - KCP_SERVICE_DOMAIN
        - KCP_DNS_TABLE
        - KCP_DNS_TABLE_FILE
        - KCP_TOKENS
        - KCP_SERVER
        - KCP_NAMESPACE
        - VERIFY_PDS
        - VERIFY_PLC
        - VERIFY_RELAY
        - PATH
        - HOME
    noPrompt: true
