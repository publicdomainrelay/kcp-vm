--- # 00-workspaces.yaml
apiVersion: tenancy.kcp.io/v1alpha1
kind: Workspace
metadata:
  name: global
spec:
  type:
    name: denoruntime
    path: root
---
apiVersion: tenancy.kcp.io/v1alpha1
kind: Workspace
metadata:
  name: relay
spec:
  type:
    name: denoruntime
    path: root
---
apiVersion: tenancy.kcp.io/v1alpha1
kind: Workspace
metadata:
  name: alice
spec:
  type:
    name: denoruntime
    path: root
---
apiVersion: tenancy.kcp.io/v1alpha1
kind: Workspace
metadata:
  name: bob
spec:
  type:
    name: denoruntime
    path: root
--- # 10-rbac.yaml
apiVersion: v1
kind: ServiceAccount
metadata:
  name: deno-runner
  namespace: default
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: deno-runner-read-pods
rules:
  - apiGroups: ["deno.computer"]
    resources: ["denopods"]
    verbs: ["get", "list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: deno-runner-read-pods
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: deno-runner-read-pods
subjects:
  - kind: ServiceAccount
    name: deno-runner
    namespace: default
