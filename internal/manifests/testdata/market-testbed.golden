--- # 20-global-plc.yaml
apiVersion: deno.computer/v1alpha1
kind: DenoPod
metadata:
  name: plc
  namespace: default
  finalizers:
    - denopod.deno.computer/run
spec:
  restartPolicy: Always
  env:
    SERVICE_ENTRY: "/org/root/atproto-market/hono-plc/mod.ts"
    SERVICE_CWD: "/org/root/atproto-market"
    SERVICE_ARGS: '["--port","0","--hostname","127.0.0.1"]'
    SERVICE_DENO_FLAGS: '["--node-modules-dir=none","--lock=/bed/locks/atproto-market.lock"]'
    SERVICE_ENV: '{"PORT":"0","HOSTNAME":"127.0.0.1"}'
    SERVICE_TLS: "true"
  script: |
    const entry = Deno.env.get("SERVICE_ENTRY") ?? "";
    const cwd = Deno.env.get("SERVICE_CWD") ?? "";
    const args: string[] = JSON.parse(Deno.env.get("SERVICE_ARGS") ?? "[]");
    const denoFlags: string[] = JSON.parse(Deno.env.get("SERVICE_DENO_FLAGS") ?? "[]");
    const serviceEnv: Record<string, string> = JSON.parse(Deno.env.get("SERVICE_ENV") ?? "{}");

    if (!entry || !cwd) {
      await Deno.writeTextFile(
        "result.json",
        JSON.stringify({ error: "SERVICE_ENTRY and SERVICE_CWD are required" }),
      );
      Deno.exit(2);
    }

    const runDir = Deno.cwd();
    const childEnv: Record<string, string> = {
      PATH: Deno.env.get("PATH") ?? "",
      HOME: Deno.env.get("HOME") ?? "",
      ...serviceEnv,
      PORT_FILE: `${runDir}/port-bound-to`,
      LISTENERS_FILE: `${runDir}/listeners.json`,
      DENO_DIR: "/cache/deno",
    };

    const caBundle = Deno.env.get("KCP_CA_BUNDLE") ?? "";
    if (caBundle) {
      const caPath = `${runDir}/ca.pem`;
      await Deno.writeTextFile(caPath, caBundle);
      childEnv.DENO_CERT = caPath;
    }

    const cert = Deno.env.get("KCP_TLS_CERT") ?? "";
    const key = Deno.env.get("KCP_TLS_KEY") ?? "";
    if (cert && key) {
      const certPath = `${runDir}/tls.crt`;
      const keyPath = `${runDir}/tls.key`;
      await Deno.writeTextFile(certPath, cert);
      await Deno.writeTextFile(keyPath, key);
      args.push("--tls-cert-file", certPath, "--tls-key-file", keyPath);
    }

    // The child resolves names with the same shim this pod was probed with.
    // A workload's own argv cannot carry --preload, so it is added here, before
    // the entry module.
    const shim = Deno.env.get("KCP_SHIM") ?? "";
    if (shim) denoFlags.unshift("--preload", shim);

    const child = new Deno.Command(Deno.execPath(), {
      args: ["run", "-A", ...denoFlags, entry, ...args],
      cwd,
      env: childEnv,
      stdin: "null",
      stdout: "inherit",
      stderr: "inherit",
    });

    const status = await child.spawn().status;
    await Deno.writeTextFile("result.json", JSON.stringify({ exitCode: String(status.code) }));
    Deno.exit(status.code);
  permissions:
    read:
      allow: true
    write:
      allowList:
        - result.json
        - tls.crt
        - tls.key
        - ca.pem
    run:
      allow: true
    env:
      allowList:
        - SERVICE_ENTRY
        - SERVICE_CWD
        - SERVICE_ARGS
        - SERVICE_DENO_FLAGS
        - SERVICE_ENV
        - SERVICE_TLS
        - KCP_SHIM
        - KCP_TLS_CERT
        - KCP_TLS_KEY
        - KCP_CA_BUNDLE
        - KCP_SERVICE_NAME
        - KCP_SERVICE_DOMAIN
        - KCP_DNS_TABLE
        - KCP_DNS_TABLE_FILE
        - KCP_TOKENS
        - KCP_SERVER
        - KCP_NAMESPACE
        - PATH
        - HOME
    noPrompt: true
  readinessProbe:
    command:
      - kcpdns
      - plc.default.global.svc.kcp.local
      - /health
    periodSeconds: 5
    failureThreshold: 6
    timeoutSeconds: 10
--- # 35-relay-dispatcher.yaml
apiVersion: deno.computer/v1alpha1
kind: DenoPod
metadata:
  name: dispatcher
  namespace: default
  finalizers:
    - denopod.deno.computer/run
spec:
  restartPolicy: Always
  serviceAccount:
    name: deno-runner
    namespace: default
  env:
    SERVICE_ENTRY: "/org/root/did-key-ingress-proxy/hono-did-key-ingress-proxy/mod.ts"
    SERVICE_CWD: "/org/root/did-key-ingress-proxy"
    SERVICE_ARGS: '["--hostname","relay.localhost","--port","0","--additional-hosts","dispatcher.default.relay.svc.kcp.local,*","--plc-directory-url","https://plc.default.global.svc.kcp.local"]'
    SERVICE_DENO_FLAGS: '["--node-modules-dir=none","--lock=/bed/locks/did-key-ingress-proxy.lock"]'
    SERVICE_TLS: "true"
    SERVICE_ENV: '{"PORT":"0"}'
  script: |
    const entry = Deno.env.get("SERVICE_ENTRY") ?? "";
    const cwd = Deno.env.get("SERVICE_CWD") ?? "";
    const args: string[] = JSON.parse(Deno.env.get("SERVICE_ARGS") ?? "[]");
    const denoFlags: string[] = JSON.parse(Deno.env.get("SERVICE_DENO_FLAGS") ?? "[]");
    const serviceEnv: Record<string, string> = JSON.parse(Deno.env.get("SERVICE_ENV") ?? "{}");

    if (!entry || !cwd) {
      await Deno.writeTextFile(
        "result.json",
        JSON.stringify({ error: "SERVICE_ENTRY and SERVICE_CWD are required" }),
      );
      Deno.exit(2);
    }

    const runDir = Deno.cwd();
    const childEnv: Record<string, string> = {
      PATH: Deno.env.get("PATH") ?? "",
      HOME: Deno.env.get("HOME") ?? "",
      ...serviceEnv,
      PORT_FILE: `${runDir}/port-bound-to`,
      LISTENERS_FILE: `${runDir}/listeners.json`,
      DENO_DIR: "/cache/deno",
    };

    const caBundle = Deno.env.get("KCP_CA_BUNDLE") ?? "";
    if (caBundle) {
      const caPath = `${runDir}/ca.pem`;
      await Deno.writeTextFile(caPath, caBundle);
      childEnv.DENO_CERT = caPath;
    }

    const shim = Deno.env.get("KCP_SHIM") ?? "";
    if (shim) denoFlags.unshift("--preload", shim);

    const child = new Deno.Command(Deno.execPath(), {
      args: ["run", "-A", ...denoFlags, entry, ...args],
      cwd,
      env: childEnv,
      stdin: "null",
      stdout: "inherit",
      stderr: "inherit",
    });

    const status = await child.spawn().status;
    await Deno.writeTextFile("result.json", JSON.stringify({ exitCode: String(status.code) }));
    Deno.exit(status.code);
  permissions:
    read:
      allow: true
    write:
      allowList:
        - result.json
        - ca.pem
    run:
      allow: true
    env:
      allowList:
        - SERVICE_ENTRY
        - SERVICE_CWD
        - SERVICE_ARGS
        - SERVICE_DENO_FLAGS
        - SERVICE_ENV
        - SERVICE_TLS
        - KCP_SHIM
        - KCP_TLS_CERT
        - KCP_TLS_KEY
        - KCP_CA_BUNDLE
        - KCP_SERVICE_NAME
        - KCP_SERVICE_DOMAIN
        - KCP_DNS_TABLE
        - KCP_DNS_TABLE_FILE
        - KCP_TOKENS
        - KCP_SERVER
        - KCP_NAMESPACE
        - PATH
        - HOME
    noPrompt: true
  readinessProbe:
    command:
      - kcpdns
      - dispatcher.default.relay.svc.kcp.local
      - /.well-known/did.json
    periodSeconds: 5
    failureThreshold: 6
    timeoutSeconds: 10
--- # 36-relay-dispatcher-tls.yaml
apiVersion: deno.computer/v1alpha1
kind: DenoPod
metadata:
  name: dispatcher-tls
  namespace: default
  finalizers:
    - denopod.deno.computer/run
spec:
  restartPolicy: Always
  serviceAccount:
    name: deno-runner
    namespace: default
  env:
    GUEST_TLS_DIR: "/bed/guest-tls"
    DISPATCHER_HOST: "relay.localhost"
    DISPATCHER_PORT: "40001"
    TLS_PORT: "0"
  script: |
    const dir = Deno.env.get("GUEST_TLS_DIR") ?? "";
    const base = Deno.env.get("DISPATCHER_HOST") ?? "relay.localhost";
    const upstreamPort = Deno.env.get("DISPATCHER_PORT") ?? "";
    const port = Number(Deno.env.get("TLS_PORT") ?? "0");
    const portFile = Deno.env.get("PORT_FILE") ?? "port-bound-to";
    const listenersFile = Deno.env.get("LISTENERS_FILE") ?? "listeners.json";
    const cert = await Deno.readTextFile(`${dir}/relay.localhost.crt`);
    const key = await Deno.readTextFile(`${dir}/relay.localhost.key`);

    const hostOnly = (h: string) => h.replace(/:\d+$/, "").toLowerCase();

    Deno.serve({
      hostname: "0.0.0.0",
      port,
      cert,
      key,
      onListen: ({ hostname, port }) => {
        Deno.writeTextFileSync(portFile, String(port));
        Deno.writeTextFileSync(listenersFile, JSON.stringify({ listeners: [{ name: "tcp", kind: "tcp", address: `${hostname}:${port}` }] }) + "\n");
        console.log(JSON.stringify({ event: "dispatcher_tls_listening", hostname, port, upstreamPort }));
      },
    }, async (req) => {
      const url = new URL(req.url);
      const host = hostOnly(url.host || (req.headers.get("host") ?? ""));
      if (host !== base && !host.endsWith(`.${base}`)) {
        console.log(JSON.stringify({ event: "dispatcher_tls_refused", host, path: url.pathname }));
        return new Response("not a dispatcher name", { status: 404 });
      }
      if ((req.headers.get("upgrade") ?? "").toLowerCase() === "websocket") {
        return new Response("websocket is served on the plain dispatcher port", { status: 501 });
      }
      const target = `http://${host}:${upstreamPort}${url.pathname}${url.search}`;
      const headers = new Headers(req.headers);
      headers.delete("host");
      try {
        const res = await fetch(target, {
          method: req.method,
          headers,
          body: req.body,
          redirect: "manual",
        });
        console.log(JSON.stringify({ event: "dispatcher_tls_proxied", host, path: url.pathname, status: res.status }));
        return res;
      } catch (err) {
        console.log(JSON.stringify({ event: "dispatcher_tls_upstream_failed", host, path: url.pathname, error: String(err) }));
        return new Response("upstream unreachable", { status: 502 });
      }
    });
  permissions:
    read:
      allow: true
    write:
      allowList:
        - port-bound-to
        - listeners.json
    net:
      allow: true
    env:
      allowList:
        - GUEST_TLS_DIR
        - DISPATCHER_HOST
        - DISPATCHER_PORT
        - TLS_PORT
        - PORT_FILE
        - LISTENERS_FILE
    noPrompt: true
--- # 40-alice-pds.yaml
apiVersion: deno.computer/v1alpha1
kind: DenoPod
metadata:
  name: pds
  namespace: default
  finalizers:
    - denopod.deno.computer/run
spec:
  restartPolicy: Always
  serviceAccount:
    name: deno-runner
    namespace: default
  env:
    SERVICE_ENTRY: "/org/root/hono-pds/main.ts"
    SERVICE_CWD: "/org/root/hono-pds"
    SERVICE_ARGS: '["--port","0","--hostname","127.0.0.1","--kv-path","/bed/state/alice-pds/kv.sqlite3"]'
    SERVICE_DENO_FLAGS: '["--node-modules-dir=none","--lock=/bed/locks/hono-pds.lock","--unstable-kv"]'
    SERVICE_ENV: '{"PORT":"0","HOSTNAME":"127.0.0.1","PDS_PUBLIC_HOSTNAME":"pds.default.alice.svc.kcp.local","PDS_PLC_DIRECTORY_URL":"https://plc.default.global.svc.kcp.local","PDS_CRAWLERS":"https://relay.default.relay.svc.kcp.local","PDS_SUBSCRIBE_REPOS_FORMAT":"json","PDS_PRIVATE_KEY_HEX":"1111111111111111111111111111111111111111111111111111111111111111"}'
    SERVICE_TLS: "true"
  script: |
    const entry = Deno.env.get("SERVICE_ENTRY") ?? "";
    const cwd = Deno.env.get("SERVICE_CWD") ?? "";
    const args: string[] = JSON.parse(Deno.env.get("SERVICE_ARGS") ?? "[]");
    const denoFlags: string[] = JSON.parse(Deno.env.get("SERVICE_DENO_FLAGS") ?? "[]");
    const serviceEnv: Record<string, string> = JSON.parse(Deno.env.get("SERVICE_ENV") ?? "{}");

    if (!entry || !cwd) {
      await Deno.writeTextFile(
        "result.json",
        JSON.stringify({ error: "SERVICE_ENTRY and SERVICE_CWD are required" }),
      );
      Deno.exit(2);
    }

    const runDir = Deno.cwd();
    const childEnv: Record<string, string> = {
      PATH: Deno.env.get("PATH") ?? "",
      HOME: Deno.env.get("HOME") ?? "",
      ...serviceEnv,
      PORT_FILE: `${runDir}/port-bound-to`,
      LISTENERS_FILE: `${runDir}/listeners.json`,
      DENO_DIR: "/cache/deno",
    };

    const caBundle = Deno.env.get("KCP_CA_BUNDLE") ?? "";
    if (caBundle) {
      const caPath = `${runDir}/ca.pem`;
      await Deno.writeTextFile(caPath, caBundle);
      childEnv.DENO_CERT = caPath;
    }

    const cert = Deno.env.get("KCP_TLS_CERT") ?? "";
    const key = Deno.env.get("KCP_TLS_KEY") ?? "";
    if (cert && key) {
      const certPath = `${runDir}/tls.crt`;
      const keyPath = `${runDir}/tls.key`;
      await Deno.writeTextFile(certPath, cert);
      await Deno.writeTextFile(keyPath, key);
      args.push("--tls-cert-file", certPath, "--tls-key-file", keyPath);
    }

    // The PDS resolves the PLC directory and the relay with the same shim this
    // pod was probed with. A workload's own argv cannot carry --preload, so it
    // is added here, before the entry module.
    const shim = Deno.env.get("KCP_SHIM") ?? "";
    if (shim) denoFlags.unshift("--preload", shim);

    const child = new Deno.Command(Deno.execPath(), {
      args: ["run", "-A", ...denoFlags, entry, ...args],
      cwd,
      env: childEnv,
      stdin: "null",
      stdout: "inherit",
      stderr: "inherit",
    });

    const status = await child.spawn().status;
    await Deno.writeTextFile("result.json", JSON.stringify({ exitCode: String(status.code) }));
    Deno.exit(status.code);
  permissions:
    read:
      allow: true
    write:
      allowList:
        - result.json
        - tls.crt
        - tls.key
        - ca.pem
    run:
      allow: true
    env:
      allowList:
        - SERVICE_ENTRY
        - SERVICE_CWD
        - SERVICE_ARGS
        - SERVICE_DENO_FLAGS
        - SERVICE_ENV
        - SERVICE_TLS
        - KCP_SHIM
        - KCP_TLS_CERT
        - KCP_TLS_KEY
        - KCP_CA_BUNDLE
        - KCP_SERVICE_NAME
        - KCP_SERVICE_DOMAIN
        - KCP_DNS_TABLE
        - KCP_DNS_TABLE_FILE
        - KCP_TOKENS
        - KCP_SERVER
        - KCP_NAMESPACE
        - PATH
        - HOME
    noPrompt: true
  readinessProbe:
    command:
      - kcpdns
      - pds.default.alice.svc.kcp.local
      - /xrpc/_health
    periodSeconds: 5
    failureThreshold: 6
    timeoutSeconds: 10
--- # 60-bob-pds.yaml
apiVersion: deno.computer/v1alpha1
