--- # 15-openbao-global.yaml
apiVersion: deno.computer/v1alpha1
kind: OpenBao
metadata:
  name: openbao
  namespace: default
  finalizers:
    - openbao.deno.computer/namespace
spec:
  # The OpenBao namespace that serves root:global/default. Its intermediate CA is
  # signed by the root CA in the OpenBao root namespace, and every DenoPod in this
  # workspace is issued its serving certificate from it.
  namespace: global.default
--- # 15-openbao-relay.yaml
apiVersion: deno.computer/v1alpha1
kind: OpenBao
metadata:
  name: openbao
  namespace: default
  finalizers:
    - openbao.deno.computer/namespace
spec:
  # The OpenBao namespace that serves root:relay/default. Its intermediate CA is
  # signed by the root CA in the OpenBao root namespace, and every DenoPod in this
  # workspace is issued its serving certificate from it.
  namespace: relay.default
