[Unit]
Description=socialweb-computer prod canary: create a tenant cluster, run a Job, delete the cluster
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=4500
Nice=10
WorkingDirectory=%h/.local/share/swc-prod-canary/checkout
ExecStart=%h/.deno/bin/deno run --node-modules-dir=none --allow-net --allow-read --allow-write=%h/.local/state/swc-prod-canary --allow-env --allow-run=kubectl,sudo scripts/prod-canary.ts
