#!/usr/bin/env bash
set -euo pipefail

# Run one compute-market bidder for one atproto account.
#
#   ExecStart=/usr/local/libexec/socialweb-computer-bidder-run %i
#
# Installed by scripts/deploy-firecracker-bidder.sh and started only by
# socialweb-computer-bidder@<handle>.service. The single argument is the unit's
# instance name, which is the handle of the account the bidder runs as.
#
# Everything host-wide comes from the environment the unit loads out of
# /etc/socialweb-computer-bidder/common.env, and anything per account out of the
# optional /etc/socialweb-computer-bidder/<handle>.env. Everything per account
# that is written lives under STATE_DIRECTORY, which systemd creates from
# StateDirectory=socialweb-computer-bidder/%i:
#
#   secrets/oauth-session.json   the OAuth session the QR sign-in saved
#   secrets/bidder-key.hex       the bidder's secp256k1 key (its did:plc)
#   pds/                         --pds-state-path
#   guests/                      the provider's work root, one dir per guest
#
# Sign-in is QR only. On first start, or after the session expires, the bidder
# prints the QR and the https://qr.fedfork.com/#oauth=... URL on stdout, which
# is the journal: journalctl -u socialweb-computer-bidder@<handle>.
#
# WHY THIS SCRIPT WATCHES THE BIDDER'S OUTPUT
#
# The QR flow signs in whichever account scans it; the bidder never compares it
# with a name it was given. So the instance name would be a label and nothing
# more. Both sign-in paths log the account's handle (oauth_qr_session_restored
# from the saved session, oauth_qr_session_ready from a fresh scan), and both
# come before bidder_ready. This passes every line through to the journal, and
# when a sign-in names another account, or bidder_ready arrives with no handle
# seen, it stops the bidder, deletes that session so the restart shows a fresh
# QR, and exits 1. An instance name that is not a lowercase handle exits 78,
# which the unit does not restart.

instance="${1:-}"
handle_pattern='^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$'

config_error() {
  printf '{"event":"bidder_config_refused","instance":"%s","reason":"%s"}\n' "${instance}" "$1" >&2
  exit 78
}

if ! [[ "${instance}" =~ ${handle_pattern} ]]; then
  config_error "the instance name must be the account's handle in lowercase, e.g. socialweb-computer-bidder@alice.bsky.social"
fi

for name in STATE_DIRECTORY BIDDER_DENO BIDDER_CODE_DIR BIDDER_SERVE_ADDR BIDDER_SERVE_PORT \
            BIDDER_INGRESS_PROXY_HOST BIDDER_PLC_DIRECTORY_URL BIDDER_POLICY \
            BIDDER_FC_NODEIMAGE BIDDER_FC_NODEBOOT BIDDER_FC_CONFIG BIDDER_FC_REPO_DIR \
            BIDDER_FC_PREINSTALL BIDDER_FC_VMM BIDDER_FC_RUNNER_IMAGE BIDDER_FC_RANGE_BASE; do
  if [ -z "${!name:-}" ]; then
    config_error "${name} is not set; it belongs in /etc/socialweb-computer-bidder/common.env"
  fi
done

state="${STATE_DIRECTORY}"
secrets="${state}/secrets"
session="${secrets}/oauth-session.json"
install -d -m 0700 "${secrets}" "${state}/pds"
install -d -m 0777 "${state}/guests"

# The bidder saves its key only after a sign-in, so a QR that times out would
# restart it under a fresh did:plc each time. The key is made here, once.
key="${secrets}/bidder-key.hex"
if [ ! -s "${key}" ]; then
  (umask 077 && od -An -vtx1 -N32 /dev/urandom | tr -d ' \n' > "${key}.tmp")
  mv "${key}.tmp" "${key}"
fi

argv=(
  "${BIDDER_DENO}" run -A --node-modules-dir=none --unstable-kv --unstable-worker-options
)
if [ -n "${BIDDER_PRELOAD:-}" ]; then
  argv+=(--preload "${BIDDER_PRELOAD}")
fi
argv+=(
  --config "${BIDDER_CODE_DIR}/atproto-market/deno.json"
  "${BIDDER_CODE_DIR}/atproto-market/hono-bidder/mod.ts"
  --service-name "socialweb-computer-bidder"
  --atproto-oauth-qr
  --oauth-session-file "${session}"
  --private-key-hex-path "${key}"
  --pds-state-path "${state}/pds"
  --ingress-proxy-host "${BIDDER_INGRESS_PROXY_HOST}"
  --plc-directory-url "${BIDDER_PLC_DIRECTORY_URL}"
  --serve-addr "${BIDDER_SERVE_ADDR}"
  --serve-port "${BIDDER_SERVE_PORT}"
  --policy "${BIDDER_POLICY}"
)
if [ -n "${BIDDER_POLICY_ARGS:-}" ]; then
  argv+=(--policy-args "${BIDDER_POLICY_ARGS}")
fi
argv+=(
  --compute-provider-firecracker
  --compute-provider-firecracker-nodeimage "${BIDDER_FC_NODEIMAGE}"
  --compute-provider-firecracker-nodeboot "${BIDDER_FC_NODEBOOT}"
  --compute-provider-firecracker-config "${BIDDER_FC_CONFIG}"
  --compute-provider-firecracker-repo-dir "${BIDDER_FC_REPO_DIR}"
  --compute-provider-firecracker-preinstall "${BIDDER_FC_PREINSTALL}"
  --compute-provider-firecracker-vmm "${BIDDER_FC_VMM}"
  --compute-provider-firecracker-runner-image "${BIDDER_FC_RUNNER_IMAGE}"
  --compute-provider-firecracker-work-root "${state}/guests"
  --compute-provider-firecracker-range-base "${BIDDER_FC_RANGE_BASE}"
  --compute-provider-firecracker-reuse-image
)

coproc BIDDER { exec "${argv[@]}" </dev/null 2>&1; }
bidder_pid="${BIDDER_PID}"
exec {from_bidder}<&"${BIDDER[0]}"

refuse() {
  printf '{"event":"bidder_account_refused","instance":"%s","signedIn":"%s","reason":"%s"}\n' \
    "${instance}" "$1" "$2" >&2
  rm -f "${session}"
  kill -TERM "${bidder_pid}" 2>/dev/null || true
  wait "${bidder_pid}" 2>/dev/null || true
  exit 1
}

verified=""
while IFS= read -r line <&"${from_bidder}" || [ -n "${line}" ]; do
  printf '%s\n' "${line}"
  case "${line}" in
    *'"message":"oauth_qr_session_restored"'* | *'"message":"oauth_qr_session_ready"'*)
      if [[ "${line}" =~ \"handle\":\"([^\"]*)\" ]]; then
        signed_in="${BASH_REMATCH[1],,}"
        if [ "${signed_in}" != "${instance}" ]; then
          refuse "${signed_in}" "the session belongs to another account; scan the QR with ${instance}"
        fi
        verified="${signed_in}"
        printf '{"event":"bidder_account_verified","instance":"%s"}\n' "${instance}"
      fi
      ;;
    *'"event":"bidder_ready"'*)
      if [ -z "${verified}" ]; then
        refuse "" "the bidder became ready without any sign-in naming its account"
      fi
      ;;
  esac
done

status=0
wait "${bidder_pid}" || status=$?
exit "${status}"
