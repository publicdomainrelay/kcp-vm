# deploy/container.env.example
#
# The one-container deployment defaults every setting below so that a bare
#
#   docker run --device=/dev/kvm -v socialweb-computer-kcp-state:/var/lib/socialweb \
#     -p 127.0.0.1:8080:8080 socialweb-control-plane:local
#
# comes up on a fresh volume with no -e at all. A real deployment must override
# these, because the defaults are placeholders for a single-host demo.

# 1. The audience a device credential is signed for, and the ATProto identity of
#    this deployment. Both must name the same audience string.
SOCIALWEB_GATEWAY_AUDIENCES=did:web:socialweb.example
SOCIALWEB_GATEWAY_DEVICE_KEY_AUDIENCE=did:web:socialweb.example

# 2. The PLC directory this gateway resolves handles and identities against.
SOCIALWEB_GATEWAY_PLC_URL=https://plc.directory

# 3. The kcp workspace that holds the device-key registry rows, and the cluster
#    this container creates. Leave SOCIALWEB_CLUSTERPROVIDER_JOIN UNSET: the
#    entrypoint then bootstraps a cluster named SOCIALWEB_CONTAINER_CLUSTER
#    (default "socialweb"), which is what a fresh deployment wants. Set it only to
#    join a cluster that ALREADY EXISTS in this kcp tree -- a name nothing created
#    makes the clusterprovider exit at startup with "no Cluster ... in the tree".
SOCIALWEB_GATEWAY_DEVKEY_REGISTRY=root:socialweb-provider
# SOCIALWEB_CLUSTERPROVIDER_JOIN=socialweb

# 4. The in-container TLS terminator in front of the loopback gateway. The
#    gateway keeps binding 127.0.0.1:8080 (SEC-2), so a publish only reaches it
#    through this terminator. Publish the terminator port:
#
#      docker run ... -p 127.0.0.1:8443:8443 ...
#
#    With no certificate supplied, the entrypoint generates a self-signed one
#    under the state volume and logs its SHA-256 fingerprint for pinning. Set
#    both to terminate with a real certificate instead (mount it read-only).
SOCIALWEB_CONTAINER_TLS_PORT=8443
SOCIALWEB_CONTAINER_TLS_CERT=
SOCIALWEB_CONTAINER_TLS_KEY=

